---
// Carte Leaflet d'une trace, sur fond Plan IGN. Les points sont calculés au build (src/lib/gpx.ts).
interface Props {
  points: [number, number][];
  titre: string;
}

const { points, titre } = Astro.props;
---

<div class="carte-trace" data-points={JSON.stringify(points)} role="img" aria-label={`Carte du parcours ${titre}`}></div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { fondDeCarte } from '../lib/fond-carte';

  for (const el of document.querySelectorAll<HTMLElement>('.carte-trace')) {
    const points = JSON.parse(el.dataset.points ?? '[]') as [number, number][];
    if (points.length === 0) continue;

    const carte = L.map(el, { scrollWheelZoom: false });
    const tuiles = fondDeCarte().addTo(carte);

    const style = getComputedStyle(document.documentElement);
    const rouge = style.getPropertyValue('--rouge-logo').trim() || '#e30613';
    const jaune = style.getPropertyValue('--jaune-logo').trim() || '#fddc09';
    const trace = L.polyline(points, { color: rouge, weight: 4, opacity: 0.85 }).addTo(carte);
    L.circleMarker(points[0], { radius: 8, color: rouge, fillColor: jaune, fillOpacity: 1, weight: 3 })
      .bindTooltip('Départ')
      .addTo(carte);
    const recadrer = () => {
      carte.invalidateSize();
      carte.fitBounds(trace.getBounds(), { padding: [20, 20] });
    };
    recadrer();

    // Bouton « Imprimer » : on donne d'abord à la carte sa taille imprimée (format-impression),
    // puis on attend le chargement des fonds de carte avant d'ouvrir l'impression.
    window.addEventListener('preparer-impression', (e) => {
      const attente = new Promise<void>((pret) => {
        el.classList.add('format-impression');
        recadrer();
        setTimeout(pret, 4000); // au pire, on imprime quand même
        if (tuiles.isLoading()) tuiles.once('load', () => setTimeout(pret, 200));
        else setTimeout(pret, 300);
      });
      (e as CustomEvent<Promise<void>[]>).detail.push(attente);
    });
    // Impression lancée autrement (Ctrl + P) : on recadre au mieux
    window.addEventListener('beforeprint', () => {
      if (!el.classList.contains('format-impression')) recadrer();
    });
    window.addEventListener('afterprint', () => {
      el.classList.remove('format-impression');
      recadrer();
    });
  }
</script>

<style>
  .carte-trace {
    height: clamp(320px, 55vh, 520px);
    border-radius: var(--rayon);
    border: 1px solid var(--bordure);
    margin: 24px 0;
  }
  /* Même taille à l'écran juste avant l'impression et sur le papier (A4, marges de 1,5 cm) :
     la carte n'a pas à se redessiner au moment d'imprimer */
  .carte-trace.format-impression { width: 18cm; max-width: 100%; height: 11cm; }
  @media print {
    .carte-trace { width: 18cm; max-width: 100%; height: 11cm; margin: 8px 0; break-inside: avoid; }
    .carte-trace :global(.leaflet-control-zoom) { display: none; }
  }
</style>
