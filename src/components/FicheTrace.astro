---
// Carte, profil d'altitude, téléchargement et impression d'une trace GPX.
// Utilisé par les parcours d'entraînement et par les événements qui ont leur propre GPX (rando, course…).
import Carte from './Carte.astro';
import ProfilAltitude from './ProfilAltitude.astro';
import type { TraceGpx } from '../lib/gpx';

interface Props {
  trace: TraceGpx;
  titre: string;
  lienGpx: string; // adresse publique du GPX, ex. lien('gpx/boucle-du-bocage.gpx')
}

const { trace, titre, lienGpx } = Astro.props;
const urlGpx = new URL(lienGpx, Astro.site);
---

<Carte points={trace.points} titre={titre} />
<ProfilAltitude profil={trace.profil} />

<p class="actions ecran-seulement">
  <a class="bouton" href={lienGpx} download>Télécharger la trace GPX</a>
  <button class="bouton secondaire" type="button" data-imprimer>Imprimer le parcours</button>
</p>
<p class="meta impression-seulement">Trace GPX : {urlGpx.href}</p>

<script>
  // La carte prépare sa version imprimée (taille, fonds de carte) avant l'ouverture de l'impression
  document.querySelector<HTMLButtonElement>('[data-imprimer]')?.addEventListener('click', async (e) => {
    const bouton = e.currentTarget as HTMLButtonElement;
    const attentes: Promise<void>[] = [];
    window.dispatchEvent(new CustomEvent('preparer-impression', { detail: attentes }));
    bouton.disabled = true;
    bouton.textContent = 'Préparation…';
    await Promise.all(attentes);
    bouton.disabled = false;
    bouton.textContent = 'Imprimer le parcours';
    window.print();
  });
</script>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  button.bouton { font: inherit; font-weight: 600; cursor: pointer; border: 0; }
</style>
