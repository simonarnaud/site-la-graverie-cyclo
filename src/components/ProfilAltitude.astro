---
// Profil d'altitude d'une trace, calculé au build (src/lib/gpx.ts) et dessiné en SVG, sans JavaScript.
interface Props {
  profil: [number, number][]; // [km, altitude en m]
}

const { profil } = Astro.props;
const LARGEUR = 1000;
const HAUTEUR = 200;

const distance = profil.at(-1)?.[0] ?? 0;
const alts = profil.map(([, a]) => a);
const altMin = Math.min(...alts);
const altMax = Math.max(...alts);

// Graduations « rondes » : 25, 50, 100, 200 m… pour l'altitude ; 1, 2, 5, 10, 20 km… pour la distance
function pasRond(etendue: number, nbVise: number) {
  const brut = etendue / nbVise;
  const puissance = 10 ** Math.floor(Math.log10(brut));
  return [1, 2, 2.5, 5, 10].map((m) => m * puissance).find((p) => p >= brut) ?? brut;
}
const pasAlt = pasRond(Math.max(altMax - altMin, 50), 3);
const bas = Math.floor(altMin / pasAlt) * pasAlt;
const haut = Math.ceil(altMax / pasAlt) * pasAlt;
const gradAlt: number[] = [];
for (let a = bas; a <= haut; a += pasAlt) gradAlt.push(a);
const pasKm = pasRond(distance, 5);
const gradKm: number[] = [];
for (let k = 0; k <= distance + 1e-9; k += pasKm) gradKm.push(Math.round(k * 10) / 10);

const x = (km: number) => (distance ? (km / distance) * LARGEUR : 0);
const y = (alt: number) => HAUTEUR - ((alt - bas) / (haut - bas || 1)) * HAUTEUR;
const ligne = profil.map(([km, alt], i) => `${i ? 'L' : 'M'}${x(km).toFixed(1)},${y(alt).toFixed(1)}`).join('');
const aire = `${ligne}L${LARGEUR},${HAUTEUR}L0,${HAUTEUR}Z`;
const pct = (v: number, total: number) => `${(v / total) * 100}%`;
---

{profil.length > 1 && (
  <figure class="profil">
    <figcaption>
      <strong>Profil d'altitude</strong>
      <span class="meta">Altitude de {altMin} à {altMax} m</span>
    </figcaption>
    <div class="trace">
      <svg viewBox={`0 0 ${LARGEUR} ${HAUTEUR}`} preserveAspectRatio="none" aria-hidden="true">
        {gradAlt.map((a) => <line x1="0" x2={LARGEUR} y1={y(a)} y2={y(a)} class="grille" />)}
        <path d={aire} class="aire" />
        <path d={ligne} class="ligne" />
      </svg>
      {gradAlt.map((a) => <span class="etiquette-alt" style={`top:${pct(y(a), HAUTEUR)}`}>{a} m</span>)}
      {gradKm.map((k) => <span class="etiquette-km" style={`left:${pct(x(k), LARGEUR)}`}>{k} km</span>)}
    </div>
  </figure>
)}

<style>
  .profil {
    margin: 24px 0; padding: 16px 18px 12px;
    background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--rayon);
    break-inside: avoid;
  }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; margin-bottom: 12px; }
  .trace { position: relative; margin: 0 4px 26px 52px; }
  svg { display: block; width: 100%; height: clamp(120px, 22vw, 180px); overflow: visible; }
  .grille { stroke: var(--bordure); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .aire { fill: color-mix(in srgb, var(--rouge-logo) 14%, transparent); }
  .ligne { fill: none; stroke: var(--rouge-logo); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .etiquette-alt, .etiquette-km { position: absolute; font-size: .75rem; color: var(--texte-doux); white-space: nowrap; }
  .etiquette-alt { right: calc(100% + 8px); transform: translateY(-50%); }
  .etiquette-km { top: calc(100% + 6px); transform: translateX(-50%); }
  @media print {
    .profil { margin: 8px 0; padding: 10px 14px 6px; }
    svg { height: 3.5cm; }
  }
</style>
