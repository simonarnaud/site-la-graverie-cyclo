---
import type { CollectionEntry } from 'astro:content';
import IconeDiscipline from './IconeDiscipline.astro';
import { CATEGORIES, DISCIPLINES } from '../lib/categories';
import { dateLongue, heure, lien } from '../lib/format';

interface Props {
  sortie: CollectionEntry<'sorties'>;
}

const { sortie } = Astro.props;
const { titre, categorie, discipline, date, lieuRdv, organisateur, niveau, annulee } = sortie.data;
---

<article class="carte" data-categorie={categorie}>
  <div class="corps">
    <p class="meta">{dateLongue(date)} · {heure(date)}</p>
    <h3><a href={lien(`sorties/${sortie.id}/`)}>{titre}</a></h3>
    {annulee && <p class="annulee">Annulé</p>}
    <p class="meta">{lieuRdv}{organisateur && ` · ${organisateur}`}</p>
    <ul class="etiquettes">
      <li class="categorie" data-categorie={categorie}>{CATEGORIES[categorie].label}</li>
      {discipline && <li class="discipline"><IconeDiscipline discipline={discipline} taille={14} />{DISCIPLINES[discipline]}</li>}
      {niveau && <li>{niveau}</li>}
    </ul>
  </div>
</article>
