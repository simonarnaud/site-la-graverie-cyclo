---
// Calendrier : un mois à la fois (grille + liste), avec navigation entre les mois
// et filtres par type et par discipline. Sans JavaScript, tous les mois s'affichent à la suite.
import Base from '../../layouts/Base.astro';
import CarteSortie from '../../components/CarteSortie.astro';
import { sortiesTriees } from '../../lib/contenus';
import { CATEGORIES, DISCIPLINES, type Categorie, type Discipline } from '../../lib/categories';
import { jourParis, lien } from '../../lib/format';

// Nombre de mois passés consultables
const MOIS_PASSES_MAX = 12;

const { toutes } = await sortiesTriees();
const evenements = [...toutes].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const aujourdhui = jourParis(new Date());
const moisCourant = aujourdhui.slice(0, 7);

// « 2026-11 » → décalé de n mois
function decaler(mois: string, n: number) {
  const [a, m] = mois.split('-').map(Number);
  const d = new Date(Date.UTC(a, m - 1 + n, 1));
  return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
}

// Mois affichés : du premier événement (au plus 12 mois en arrière) au dernier (au moins le mois courant)
const moisEvenements = evenements.map((s) => jourParis(s.data.date).slice(0, 7));
const plusAncien = decaler(moisCourant, -MOIS_PASSES_MAX);
let debut = moisEvenements[0] && moisEvenements[0] < moisCourant ? moisEvenements[0] : moisCourant;
if (debut < plusAncien) debut = plusAncien;
const fin = moisEvenements.at(-1) && moisEvenements.at(-1)! > moisCourant ? moisEvenements.at(-1)! : moisCourant;
const listeMois: string[] = [];
for (let m = debut; m <= fin; m = decaler(m, 1)) listeMois.push(m);

const parMois = new Map(listeMois.map((m) => [m, evenements.filter((s) => jourParis(s.data.date).startsWith(m))]));

const JOURS = ['lun', 'mar', 'mer', 'jeu', 'ven', 'sam', 'dim'];

function semaines(mois: string, evts: typeof evenements) {
  const [annee, m] = mois.split('-').map(Number);
  const decalage = (new Date(Date.UTC(annee, m - 1, 1)).getUTCDay() + 6) % 7; // lundi = 0
  const nbJours = new Date(Date.UTC(annee, m, 0)).getUTCDate();
  const cases: ({ jour: number; date: string; evenements: typeof evenements } | null)[] = Array(decalage).fill(null);
  for (let j = 1; j <= nbJours; j++) {
    const date = `${mois}-${String(j).padStart(2, '0')}`;
    cases.push({ jour: j, date, evenements: evts.filter((s) => jourParis(s.data.date) === date) });
  }
  while (cases.length % 7) cases.push(null);
  return Array.from({ length: cases.length / 7 }, (_, i) => cases.slice(i * 7, i * 7 + 7));
}

function nomMois(mois: string) {
  const [annee, m] = mois.split('-').map(Number);
  const nom = new Date(Date.UTC(annee, m - 1, 15)).toLocaleDateString('fr-FR', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  return nom.charAt(0).toUpperCase() + nom.slice(1);
}

const categoriesPresentes = (Object.keys(CATEGORIES) as Categorie[]).filter((c) => evenements.some((s) => s.data.categorie === c));
const disciplinesPresentes = (Object.keys(DISCIPLINES) as Discipline[]).filter((d) => evenements.some((s) => s.data.discipline === d));
---

<Base titre="Calendrier" description="Sorties club, randos et courses">
  <h1>Calendrier</h1>
  <p>
    Sorties club, randos et courses.
    Ajoutez tout le calendrier à l'agenda de votre téléphone : <a href={lien('sorties.ics')}>s'abonner</a>.
  </p>

  <div class="filtres" hidden>
    <div class="filtre-groupe" role="group" aria-label="Filtrer par type" data-groupe="type">
      <span class="filtre-titre">Type</span>
      <button type="button" aria-pressed="true" data-filtre="tout">Tout</button>
      {categoriesPresentes.map((c) => (
        <button type="button" aria-pressed="false" data-filtre={c} data-categorie={c}>{CATEGORIES[c].pluriel}</button>
      ))}
    </div>
    {disciplinesPresentes.length > 0 && (
      <div class="filtre-groupe" role="group" aria-label="Filtrer par discipline" data-groupe="discipline">
        <span class="filtre-titre">Discipline</span>
        <button type="button" aria-pressed="true" data-filtre="tout">Toutes</button>
        {disciplinesPresentes.map((d) => (
          <button type="button" aria-pressed="false" data-filtre={d}>{DISCIPLINES[d]}</button>
        ))}
      </div>
    )}
  </div>

  <nav class="navigation-mois" aria-label="Choisir le mois" hidden>
    <button type="button" class="fleche" data-pas="-1" aria-label="Mois précédent">‹</button>
    <select aria-label="Mois affiché">
      {listeMois.map((m) => {
        const n = parMois.get(m)!.length;
        return <option value={m} selected={m === moisCourant}>{nomMois(m)}{n > 0 ? ` · ${n} événement${n > 1 ? 's' : ''}` : ''}</option>;
      })}
    </select>
    <button type="button" class="fleche" data-pas="1" aria-label="Mois suivant">›</button>
    <button type="button" class="ce-mois" data-mois={moisCourant}>Ce mois-ci</button>
  </nav>

  {listeMois.map((mois) => {
    const evts = parMois.get(mois)!;
    return (
      <section class="mois section" data-mois={mois}>
        <h2>{nomMois(mois)}</h2>
        <div class="mois-contenu">
          <table class="mini-mois" aria-hidden="true">
            <thead><tr>{JOURS.map((j) => <th>{j}</th>)}</tr></thead>
            <tbody>
              {semaines(mois, evts).map((semaine) => (
                <tr>
                  {semaine.map((c) =>
                    c ? (
                      <td class:list={[{ aujourdhui: c.date === aujourdhui, passe: c.date < aujourdhui }]}>
                        <span class="numero">{c.jour}</span>
                        {c.evenements.map((s) => (
                          <a class="pastille" href={`#${s.id}`} data-categorie={s.data.categorie} data-type={s.data.categorie} data-discipline={s.data.discipline} title={s.data.titre}></a>
                        ))}
                      </td>
                    ) : (
                      <td />
                    ),
                  )}
                </tr>
              ))}
            </tbody>
          </table>

          <div class="liste">
            {evts.length > 0 ? (
              evts.map((s) => (
                <div class:list={['evenement', { passe: jourParis(s.data.date) < aujourdhui }]} id={s.id} data-type={s.data.categorie} data-discipline={s.data.discipline}>
                  <CarteSortie sortie={s} />
                </div>
              ))
            ) : (
              <p class="vide">Rien de prévu ce mois-ci pour le moment.</p>
            )}
            <p class="vide aucun" hidden>Aucun événement correspondant ce mois-ci.</p>
          </div>
        </div>
      </section>
    );
  })}
</Base>

<script>
  const nav = document.querySelector<HTMLElement>('.navigation-mois');
  const select = nav?.querySelector('select');
  const sections = [...document.querySelectorAll<HTMLElement>('.mois')];

  // --- Navigation : un seul mois affiché ---
  function afficher(mois: string) {
    if (!select || !sections.some((s) => s.dataset.mois === mois)) return;
    select.value = mois;
    sections.forEach((s) => (s.hidden = s.dataset.mois !== mois));
    const i = sections.findIndex((s) => s.dataset.mois === mois);
    nav!.querySelector<HTMLButtonElement>('[data-pas="-1"]')!.disabled = i === 0;
    nav!.querySelector<HTMLButtonElement>('[data-pas="1"]')!.disabled = i === sections.length - 1;
    const url = new URL(location.href);
    url.searchParams.set('mois', mois);
    history.replaceState(null, '', url);
  }

  if (nav && select) {
    nav.hidden = false;
    document.documentElement.classList.add('calendrier-js');
    select.addEventListener('change', () => afficher(select.value));
    nav.addEventListener('click', (e) => {
      const bouton = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!bouton) return;
      if (bouton.dataset.mois) return afficher(bouton.dataset.mois);
      const i = sections.findIndex((s) => s.dataset.mois === select.value) + Number(bouton.dataset.pas);
      if (sections[i]) afficher(sections[i].dataset.mois!);
    });

    // Mois de départ : ?mois=…, sinon celui de l'événement visé par le lien (#id), sinon le mois courant
    const demande = new URL(location.href).searchParams.get('mois');
    const cible = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    afficher(demande ?? cible?.closest<HTMLElement>('.mois')?.dataset.mois ?? select.value);
  }

  // --- Filtres par type et par discipline (cumulables) ---
  const filtres = document.querySelector<HTMLElement>('.filtres');
  if (filtres) {
    filtres.hidden = false;
    const choix: Record<string, string> = { type: 'tout', discipline: 'tout' };
    const correspond = (el: HTMLElement) =>
      (choix.type === 'tout' || el.dataset.type === choix.type) &&
      (choix.discipline === 'tout' || el.dataset.discipline === choix.discipline);

    filtres.addEventListener('click', (e) => {
      const bouton = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filtre]');
      const groupe = bouton?.closest<HTMLElement>('[data-groupe]');
      if (!bouton || !groupe) return;
      choix[groupe.dataset.groupe!] = bouton.dataset.filtre!;
      groupe.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)));

      document.querySelectorAll<HTMLElement>('.evenement').forEach((el) => (el.hidden = !correspond(el)));
      document.querySelectorAll<HTMLElement>('.pastille').forEach((el) => el.classList.toggle('attenuee', !correspond(el)));
      sections.forEach((mois) => {
        const tous = mois.querySelectorAll('.evenement');
        const visibles = mois.querySelectorAll('.evenement:not([hidden])');
        mois.querySelector<HTMLElement>('.aucun')!.hidden = tous.length === 0 || visibles.length > 0;
      });
    });
  }
</script>

<style>
  .filtres { display: grid; gap: 10px; margin: 24px 0 0; }
  .filtre-groupe { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .filtre-titre { width: 88px; font-size: .85rem; font-weight: 600; color: var(--texte-doux); }
  @media (max-width: 640px) { .filtre-titre { width: 100%; } }
  .filtres button {
    font: inherit; font-size: .9rem; font-weight: 600; cursor: pointer;
    padding: 6px 14px; border-radius: 999px;
    border: 1px solid var(--bordure); background: var(--surface); color: var(--texte-doux);
  }
  .filtres button[data-categorie] { color: var(--c); }
  .filtres button[aria-pressed='true'] { background: var(--texte); border-color: var(--texte); color: var(--fond); }
  .filtres button[data-categorie][aria-pressed='true'] { background: var(--c); border-color: var(--c); color: var(--surface); }

  .navigation-mois { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 32px 0 0; }
  .navigation-mois select, .navigation-mois button {
    font: inherit; font-weight: 600; color: var(--texte);
    background: var(--surface); border: 1px solid var(--bordure); border-radius: 999px;
  }
  .navigation-mois select { padding: 8px 14px; font-size: 1.1rem; min-width: 0; max-width: 100%; cursor: pointer; }
  .navigation-mois .fleche { width: 42px; height: 42px; font-size: 1.4rem; line-height: 1; cursor: pointer; }
  .navigation-mois .fleche:disabled { opacity: .35; cursor: default; }
  .navigation-mois .ce-mois { padding: 8px 14px; font-size: .9rem; color: var(--accent); cursor: pointer; }
  @media (max-width: 640px) {
    .navigation-mois select { flex: 1 1 0; font-size: 1rem; }
    .navigation-mois .fleche { flex-shrink: 0; }
    .navigation-mois .ce-mois { order: 1; }
  }
  /* Avec la navigation, le nom du mois est déjà dans la liste déroulante */
  :global(.calendrier-js) .mois { margin-top: 20px; }
  :global(.calendrier-js) .mois h2 {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }

  .mois-contenu { display: grid; gap: 24px; grid-template-columns: minmax(260px, 340px) 1fr; align-items: start; }
  @media (max-width: 760px) { .mois-contenu { grid-template-columns: 1fr; } }

  .mini-mois {
    width: 100%; border-collapse: separate; border-spacing: 3px; table-layout: fixed;
    background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--rayon); padding: 8px;
  }
  .mini-mois th { font-size: .75rem; font-weight: 600; color: var(--texte-doux); text-transform: uppercase; padding-bottom: 4px; }
  .mini-mois td { height: 42px; vertical-align: top; text-align: center; border-radius: 8px; font-size: .85rem; }
  .mini-mois td.passe .numero { color: var(--texte-doux); opacity: .55; }
  .mini-mois td.aujourdhui { box-shadow: inset 0 0 0 2px var(--jaune); font-weight: 700; }
  .numero { display: block; line-height: 1.6; }
  .pastille { display: inline-block; width: 9px; height: 9px; margin: 0 1px; border-radius: 50%; background: var(--c); }
  .pastille.attenuee { opacity: .15; }

  .liste { display: grid; gap: 14px; }
  .liste .vide { margin: 8px 0; }
  .evenement.passe { opacity: .7; }
</style>
