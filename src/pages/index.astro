---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Base from '../layouts/Base.astro';
import CarteSortie from '../components/CarteSortie.astro';
import CarteActu from '../components/CarteActu.astro';
import club from '../data/club.json';
import { sortiesTriees, actualitesPubliees } from '../lib/contenus';
import { lien } from '../lib/format';

const { aVenir } = await sortiesTriees();
const actus = (await actualitesPubliees()).slice(0, 3);
---

<Base>
  <section class="accueil">
    <div>
      <h1>{club.nom}</h1>
      <p class="slogan">{club.slogan}</p>
      <p class="actions">
        <a class="bouton" href={lien('sorties/')}>Voir les prochaines sorties</a>
        <a class="bouton secondaire" href={club.lienAdhesion || lien('le-club/')}>
          {club.lienAdhesion ? 'Adhérer au club' : 'Découvrir le club'}
        </a>
      </p>
    </div>
    <Image src={logo} alt={`Logo de ${club.nom}`} width={260} height={260} loading="eager" class="accueil-logo" />
  </section>

  <section class="section">
    <div class="section-titre">
      <h2>Prochaines sorties</h2>
      <a href={lien('sorties/')}>Toutes les sorties →</a>
    </div>
    {aVenir.length > 0 ? (
      <div class="grille">{aVenir.slice(0, 3).map((sortie) => <CarteSortie sortie={sortie} />)}</div>
    ) : (
      <p class="vide">Aucune sortie programmée pour le moment.</p>
    )}
  </section>

  <section class="section">
    <div class="section-titre">
      <h2>Actualités</h2>
      <a href={lien('actualites/')}>Toutes les actualités →</a>
    </div>
    {actus.length > 0 ? (
      <div class="grille">{actus.map((actu) => <CarteActu actu={actu} />)}</div>
    ) : (
      <p class="vide">Pas encore d'actualité.</p>
    )}
  </section>
</Base>

<style>
  .accueil {
    display: flex; align-items: center; justify-content: space-between; gap: 24px 40px;
    padding: 32px clamp(20px, 4vw, 48px);
    background: var(--surface); border: 1px solid var(--bordure); border-radius: 20px; box-shadow: var(--ombre);
    /* touche jaune très légère dans le coin, sans effet « flash » */
    background-image: radial-gradient(circle at 100% 0%, var(--jaune-doux), transparent 45%);
  }
  .slogan { font-size: 1.2rem; color: var(--texte-doux); margin: 0 0 1.4em; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; }
  .accueil-logo { flex-shrink: 0; width: clamp(140px, 24vw, 240px); border-radius: 50%; background: #fff; }
  @media (max-width: 640px) {
    .accueil { flex-direction: column-reverse; text-align: center; }
    .actions { justify-content: center; }
  }
</style>
