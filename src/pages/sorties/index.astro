---
// Ancienne adresse de la liste des sorties, conservée pour les liens déjà partagés.
import { lien } from '../../lib/format';
const cible = lien('calendrier/');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${cible}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(cible, Astro.site)} />
    <title>Calendrier</title>
  </head>
  <body><a href={cible}>Le calendrier a déménagé : cliquez ici.</a></body>
</html>
