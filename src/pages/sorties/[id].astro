---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES, DISCIPLINES } from '../../lib/categories';
import { dateLongue, heure, jourParis, lien } from '../../lib/format';

export async function getStaticPaths() {
  const sorties = await getCollection('sorties');
  return sorties.map((sortie) => ({ params: { id: sortie.id }, props: { sortie } }));
}

const { sortie } = Astro.props;
const { titre, categorie, discipline, date, dureeHeures, lieuRdv, organisateur, niveau, lienInscription, annulee } = sortie.data;
const libelle = CATEGORIES[categorie].label;
const parcours = sortie.data.parcours ? await getEntry(sortie.data.parcours) : undefined;
const { Content } = await render(sortie);
const aVenir = date.getTime() > Date.now();
---

<Base titre={titre} description={`${libelle} du ${dateLongue(date)} : ${titre}`}>
  <p class="meta"><a href={lien(`calendrier/?mois=${jourParis(date).slice(0, 7)}`)}>← Calendrier</a></p>
  <p><span class="categorie" data-categorie={categorie}>{libelle}</span></p>
  <h1>{titre}</h1>
  {annulee && <p class="annulee">Cet événement est annulé.</p>}

  <dl class="infos">
    <div><dt>Date</dt><dd>{dateLongue(date)}</dd></div>
    <div><dt>Départ</dt><dd>{heure(date)} · {lieuRdv}</dd></div>
    <div><dt>Durée estimée</dt><dd>{dureeHeures} h</dd></div>
    {discipline && <div><dt>Discipline</dt><dd>{DISCIPLINES[discipline]}</dd></div>}
    {niveau && <div><dt>Niveau</dt><dd>{niveau}</dd></div>}
    {organisateur && <div><dt>Organisateur</dt><dd>{organisateur}</dd></div>}
    {parcours && (
      <div><dt>Parcours</dt><dd><a href={lien(`parcours/${parcours.id}/`)}>{parcours.data.titre}</a></dd></div>
    )}
  </dl>

  {lienInscription && aVenir && !annulee && (
    <p><a class="bouton" href={lienInscription} rel="noopener">{categorie === 'sortie' ? 'Je participe' : "S'inscrire"}</a></p>
  )}

  <div class="prose"><Content /></div>
</Base>

<style>
  .infos { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); margin: 24px 0; }
  .infos div { background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--rayon); padding: 12px 14px; }
  .infos dt { color: var(--texte-doux); font-size: .85rem; }
  .infos dd { margin: 0; font-weight: 600; }
</style>
