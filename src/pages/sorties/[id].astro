---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LienRetour from '../../components/LienRetour.astro';
import IconeDiscipline from '../../components/IconeDiscipline.astro';
import FicheTrace from '../../components/FicheTrace.astro';
import { CATEGORIES, DISCIPLINES } from '../../lib/categories';
import { cheminFichier } from '../../lib/fichiers';
import { dateLongue, horaire, horaireConnu, jourParis, lien } from '../../lib/format';
import { lireGpx } from '../../lib/gpx';

export async function getStaticPaths() {
  const sorties = await getCollection('sorties');
  return sorties.map((sortie) => ({ params: { id: sortie.id }, props: { sortie } }));
}

const { sortie } = Astro.props;
const { titre, categorie, discipline, date, lieuRdv, pointDepart, organisateur, lienStrava, lienInscription, annulee, couverture, couvertureAlt } = sortie.data;
// Point de départ placé dans le CMS : ouverture dans Google Maps (application sur téléphone, site sinon)
const coordonnees = pointDepart && `${pointDepart.latitude},${pointDepart.longitude}`;
const libelle = CATEGORIES[categorie].label;
const parcours = sortie.data.parcours ? await getEntry(sortie.data.parcours) : undefined;
// GPX propre à l'événement (rando, course…), publié en /gpx/evenements/<id>.gpx
const trace = sortie.data.gpx ? lireGpx(cheminFichier(sortie, sortie.data.gpx)) : undefined;
const { Content } = await render(sortie);
const aVenir = date.getTime() > Date.now();
---

<Base titre={titre} description={`${libelle} du ${dateLongue(date)} : ${titre}`} apercu={couverture}>
  <LienRetour href={lien(`calendrier/?mois=${jourParis(date).slice(0, 7)}`)} libelle="Calendrier" />
  <p><span class="categorie" data-categorie={categorie}>{libelle}</span></p>
  <h1>{titre}</h1>
  {annulee && <p class="annulee">Cet événement est annulé.</p>}
  {couverture && <Image src={couverture} alt={couvertureAlt ?? ''} width={1100} class="illustration" />}

  <dl class="infos">
    <div><dt>Date</dt><dd>{dateLongue(date)}</dd></div>
    <div>
      <dt>Départ</dt>
      <dd>{!horaireConnu(date) && lieuRdv === 'À préciser' ? 'Horaire et lieu à préciser' : `${horaire(date)} · ${lieuRdv}`}</dd>
      {coordonnees && (
        <dd class="carte-depart">
          <a href={`https://www.google.com/maps/search/?api=1&query=${coordonnees}`} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" />
            </svg>
            Voir sur Google Maps ↗
          </a>
          <a href={`https://www.google.com/maps/dir/?api=1&destination=${coordonnees}`} target="_blank" rel="noopener">Itinéraire ↗</a>
        </dd>
      )}
    </div>
    {discipline && <div><dt>Discipline</dt><dd class="avec-icone"><IconeDiscipline discipline={discipline} taille={18} />{DISCIPLINES[discipline]}</dd></div>}
    {organisateur && <div><dt>Organisateur</dt><dd>{organisateur}</dd></div>}
    {parcours && (
      <div><dt>Parcours</dt><dd><a href={lien(`parcours/${parcours.id}/`)}>{parcours.data.titre}</a></dd></div>
    )}
    {trace && <div><dt>Parcours</dt><dd>{trace.distanceKm} km · {trace.deniveleM} m D+</dd></div>}
  </dl>

  {aVenir && !annulee && (lienStrava || lienInscription) && (
    <div class="participation">
      <p class="actions">
        {lienStrava && <a class="bouton" href={lienStrava} target="_blank" rel="noopener">Je participe sur Strava ↗</a>}
        {lienInscription && <a class="bouton secondaire" href={lienInscription} target="_blank" rel="noopener">S'inscrire auprès de l'organisateur ↗</a>}
      </p>
      {lienStrava && <p class="meta">Indiquez votre participation sur l'événement Strava du club : on saura combien nous serons.</p>}
    </div>
  )}

  <div class="prose"><Content /></div>

  {trace && (
    <section class="section">
      <h2>Le parcours</h2>
      <FicheTrace trace={trace} titre={titre} lienGpx={lien(`gpx/evenements/${sortie.id}.gpx`)} />
    </section>
  )}
</Base>

<style>
  .infos { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); margin: 24px 0; }
  .infos div { background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--rayon); padding: 12px 14px; }
  .infos dt { color: var(--texte-doux); font-size: .85rem; }
  .infos dd { margin: 0; font-weight: 600; }
  .infos dd.avec-icone { display: flex; align-items: center; gap: 6px; }
  .infos dd.carte-depart { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 6px; font-size: .9rem; }
  .carte-depart a { display: inline-flex; align-items: center; gap: 4px; }
  .participation { margin: 0 0 24px; }
  /* Jamais agrandie au-delà de sa taille réelle (une petite image resterait floue) */
  .illustration { margin: 16px 0 0; border-radius: var(--rayon); max-height: 480px; width: auto; max-width: 100%; height: auto; object-fit: cover; }
  .participation .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 8px; }
</style>
