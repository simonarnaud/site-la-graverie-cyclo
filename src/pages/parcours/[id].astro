---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LienRetour from '../../components/LienRetour.astro';
import Carte from '../../components/Carte.astro';
import ProfilAltitude from '../../components/ProfilAltitude.astro';
import club from '../../data/club.json';
import { lireGpx } from '../../lib/gpx';
import { lien } from '../../lib/format';

export async function getStaticPaths() {
  const parcours = await getCollection('parcours');
  return parcours.map((p) => ({ params: { id: p.id }, props: { parcours: p } }));
}

const { parcours } = Astro.props;
const { titre, type, difficulte, gpx } = parcours.data;
const trace = lireGpx(gpx);
const distanceKm = parcours.data.distanceKm ?? trace.distanceKm;
const deniveleM = parcours.data.deniveleM ?? trace.deniveleM;
const { Content } = await render(parcours);
const urlGpx = new URL(lien(gpx), Astro.site);
---

<Base titre={titre} description={`${titre} : ${distanceKm} km, ${deniveleM} m de dénivelé`} apercu={parcours.data.couverture}>
  <LienRetour href={lien('parcours/')} libelle="Tous les parcours" />
  <p class="meta impression-seulement">{club.nom}</p>
  <h1>{titre}</h1>
  <p class="meta">{[`${distanceKm} km`, `${deniveleM} m D+`, type, difficulte].filter(Boolean).join(' · ')}</p>

  <Carte points={trace.points} titre={titre} />
  <ProfilAltitude profil={trace.profil} />

  <p class="actions ecran-seulement">
    <a class="bouton" href={lien(gpx)} download>Télécharger la trace GPX</a>
    <button class="bouton secondaire" type="button" data-imprimer>Imprimer le parcours</button>
  </p>
  <p class="meta impression-seulement">Trace GPX : {urlGpx.href}</p>

  <div class="prose"><Content /></div>
</Base>

<script>
  // La carte prépare sa version imprimée (taille, fonds de carte) avant l'ouverture de l'impression
  document.querySelector<HTMLButtonElement>('[data-imprimer]')?.addEventListener('click', async (e) => {
    const bouton = e.currentTarget as HTMLButtonElement;
    const attentes: Promise<void>[] = [];
    window.dispatchEvent(new CustomEvent('preparer-impression', { detail: attentes }));
    bouton.disabled = true;
    bouton.textContent = 'Préparation…';
    await Promise.all(attentes);
    bouton.disabled = false;
    bouton.textContent = 'Imprimer le parcours';
    window.print();
  });
</script>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  button.bouton { font: inherit; font-weight: 600; cursor: pointer; border: 0; }
</style>
