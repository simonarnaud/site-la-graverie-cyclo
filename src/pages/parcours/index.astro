---
// Liste des parcours : recherche par mot-clé, filtres (type, distance) et tri, côté navigateur.
// Sans JavaScript, la liste complète s'affiche, triée par distance.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { cheminFichier } from '../../lib/fichiers';
import { lireGpx } from '../../lib/gpx';
import { lien } from '../../lib/format';

// Texte cherchable : sans accents ni majuscules (« Montée » est trouvé en tapant « montee »)
const normaliser = (texte: string) => texte.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();

const parcours = (await getCollection('parcours'))
  .map((p) => {
    const trace = lireGpx(cheminFichier(p, p.data.gpx));
    const description = (p.body ?? '').replace(/[*_#>`[\]()]/g, ' ');
    return {
      ...p,
      distanceKm: p.data.distanceKm ?? trace.distanceKm,
      deniveleM: p.data.deniveleM ?? trace.deniveleM,
      texte: normaliser([p.data.titre, p.data.type, description].join(' ')),
    };
  })
  .sort((a, b) => a.distanceKm - b.distanceKm);

const types = [...new Set(parcours.map((p) => p.data.type))];
const DISTANCES = [
  { id: 'courte', label: 'Moins de 50 km', min: 0, max: 50 },
  { id: 'moyenne', label: '50 à 100 km', min: 50, max: 100 },
  { id: 'longue', label: 'Plus de 100 km', min: 100, max: Infinity },
];
const distanceDe = (km: number) => DISTANCES.find((d) => km >= d.min && km < d.max)!.id;
---

<Base titre="Parcours" description="Les parcours du club, avec traces GPX à télécharger">
  <h1>Parcours</h1>

  {parcours.length > 0 && (
    <div class="recherche" hidden>
      <input type="search" placeholder="Rechercher un parcours (nom, lieu, description…)" aria-label="Rechercher un parcours" />
      <div class="options">
        <div class="groupe" role="group" aria-label="Type de parcours" data-groupe="type">
          <button type="button" aria-pressed="true" data-valeur="">Tous</button>
          {types.map((t) => <button type="button" aria-pressed="false" data-valeur={t}>{t}</button>)}
        </div>
        <div class="groupe" role="group" aria-label="Distance" data-groupe="distance">
          <button type="button" aria-pressed="true" data-valeur="">Toutes distances</button>
          {DISTANCES.map((d) => <button type="button" aria-pressed="false" data-valeur={d.id}>{d.label}</button>)}
        </div>
        <label class="tri">
          Trier par
          <select>
            <option value="distance">distance croissante</option>
            <option value="-distance">distance décroissante</option>
            <option value="denivele">dénivelé</option>
            <option value="nom">nom</option>
          </select>
        </label>
      </div>
      <p class="meta compteur" aria-live="polite"></p>
    </div>
  )}

  {parcours.length > 0 ? (
    <div class="grille liste-parcours">
      {parcours.map((p) => (
        <article
          class="carte parcours"
          data-texte={p.texte}
          data-type={p.data.type}
          data-distance={distanceDe(p.distanceKm)}
          data-km={p.distanceKm}
          data-denivele={p.deniveleM}
          data-nom={normaliser(p.data.titre)}
        >
          {p.data.couverture && <Image src={p.data.couverture} alt={p.data.couvertureAlt ?? ''} width={640} />}
          <div class="corps">
            <h3><a href={lien(`parcours/${p.id}/`)}>{p.data.titre}</a></h3>
            <p class="meta">{p.distanceKm} km · {p.deniveleM} m D+</p>
            <ul class="etiquettes"><li>{p.data.type}</li></ul>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="vide">Aucun parcours pour le moment.</p>
  )}
  <p class="vide aucun" hidden>Aucun parcours ne correspond à votre recherche.</p>
</Base>

<script>
  const recherche = document.querySelector<HTMLElement>('.recherche');
  const liste = document.querySelector<HTMLElement>('.liste-parcours');
  if (recherche && liste) {
    recherche.hidden = false;
    const champ = recherche.querySelector('input')!;
    const tri = recherche.querySelector('select')!;
    const cartes = [...liste.querySelectorAll<HTMLElement>('.parcours')];
    const choix: Record<string, string> = { type: '', distance: '' };
    const normaliser = (t: string) => t.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();

    function appliquer() {
      // Chaque mot tapé doit apparaître quelque part dans le parcours
      const mots = normaliser(champ.value).split(/\s+/).filter(Boolean);
      let visibles = 0;
      for (const carte of cartes) {
        const ok =
          mots.every((m) => carte.dataset.texte!.includes(m)) &&
          (!choix.type || carte.dataset.type === choix.type) &&
          (!choix.distance || carte.dataset.distance === choix.distance);
        carte.hidden = !ok;
        if (ok) visibles++;
      }
      const [cle, sens] = tri.value.startsWith('-') ? [tri.value.slice(1), -1] : [tri.value, 1];
      const valeur = (c: HTMLElement) =>
        cle === 'nom' ? c.dataset.nom! : Number(cle === 'denivele' ? c.dataset.denivele : c.dataset.km);
      cartes
        .sort((a, b) => (valeur(a) > valeur(b) ? 1 : valeur(a) < valeur(b) ? -1 : 0) * sens)
        .forEach((c) => liste!.append(c));
      recherche!.querySelector('.compteur')!.textContent = `${visibles} parcours sur ${cartes.length}`;
      document.querySelector<HTMLElement>('.aucun')!.hidden = visibles > 0;
    }

    champ.addEventListener('input', appliquer);
    tri.addEventListener('change', appliquer);
    recherche.addEventListener('click', (e) => {
      const bouton = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-valeur]');
      const groupe = bouton?.closest<HTMLElement>('[data-groupe]');
      if (!bouton || !groupe) return;
      choix[groupe.dataset.groupe!] = bouton.dataset.valeur!;
      groupe.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)));
      appliquer();
    });
    appliquer();
  }
</script>

<style>
  .recherche { display: grid; gap: 12px; margin: 8px 0 24px; }
  .recherche input {
    width: 100%; font: inherit; padding: 12px 18px; border-radius: 999px;
    border: 1px solid var(--bordure); background: var(--surface); color: var(--texte);
  }
  .recherche input:focus { outline: 2px solid var(--jaune); outline-offset: 1px; }
  .options { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; }
  .groupe { display: flex; flex-wrap: wrap; gap: 6px; }
  .groupe button {
    font: inherit; font-size: .88rem; font-weight: 600; cursor: pointer;
    padding: 5px 12px; border-radius: 999px;
    border: 1px solid var(--bordure); background: var(--surface); color: var(--texte-doux);
  }
  .groupe button[aria-pressed='true'] { background: var(--texte); border-color: var(--texte); color: var(--fond); }
  [data-groupe='type'] button { text-transform: capitalize; } /* route → Route */
  .tri { display: flex; align-items: center; gap: 8px; font-size: .88rem; color: var(--texte-doux); }
  .tri select {
    font: inherit; color: var(--texte); cursor: pointer;
    padding: 5px 10px; border-radius: 999px; border: 1px solid var(--bordure); background: var(--surface);
  }
  .compteur { margin: 0; }
  .parcours[hidden] { display: none; }
</style>
